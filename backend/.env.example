# =========================================================================
# Raju Perumalla Portfolio - Backend Environment Variables Template
# =========================================================================
# CONFIDENTIAL: Server-side environment variables only.
# NEVER commit the actual .env file or sensitive production secrets to Git.
# =========================================================================

# Server Port
PORT=5000

# Allowed CORS Origins (comma-separated for production and development)
ALLOWED_ORIGINS=https://www.rajuperumalla.in,https://rajuperumalla.in,http://localhost:5173,http://localhost:3000

# Administrative API Key (Required to query /api/contacts)
# Generate a strong, random 32+ character key for production
ADMIN_API_KEY=your_secure_random_admin_api_key_here

# Supabase Server Configuration
SUPABASE_URL=https://hjtxvqgpvcmiktyyanxb.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (OPTIONAL: For elevated administrative operations)
# Keep strictly confidential. Never expose to client bundles.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# MongoDB Connection String (Optional backup database)
MONGO_URI=mongodb://localhost:27017/portfolio

# EmailJS Relay Credentials (Server-side relay)
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_here
